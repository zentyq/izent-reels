generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  name            String?
  passwordHash    String?
  phone           String?  @unique
  instagramCookie String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions   Session[]
  chats      Chat[]
  profiles   AyrshareProfile[]
  series     Series[]
  studioJobs StudioJob[]
}

model AyrshareProfile {
  id         String   @id @default(cuid())
  userId     String
  profileKey String   @unique
  title      String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Series {
  id              String   @id @default(cuid())
  userId          String
  name            String
  /// short (9:16 reels) | long (16:9 YouTube/Facebook)
  videoFormat     String   @default("short")
  /// faceless | ugc | commercial
  contentMode     String   @default("faceless")
  niche           String
  nicheMode       String   @default("preset")
  customNiche     String?
  exampleScript   String?
  /// Polished narration from YouTube import — generation must not invent a new story
  lockedScript    String?
  sourceYoutubeUrl String?
  voiceId         String   @default("JBFqnCBsd6RMkjVDRZzb")
  /// User-uploaded narration audio (mp3/wav/m4a) — used instead of ElevenLabs when set
  customVoiceUrl  String?
  /// Skip ElevenLabs narration (UGC / commercial / silent "normal" video)
  skipVoice       Boolean  @default(false)
  musicIds        String[] @default([])
  customMusicUrls String[] @default([])
  skipMusic       Boolean  @default(false)
  artStyle        String
  /// @deprecated use referenceImageUrls
  referenceImageUrl String?
  /// Product / brand / subject photos for UGC & commercial (AI reference)
  referenceImageUrls String[] @default([])
  captionStyle    String   @default("bold-stroke")
  skipCaptions    Boolean  @default(false)
  glitchEffect    Boolean  @default(false)
  /// deprecated: prefer visualMode
  animatedHook    Boolean  @default(false)
  /// images | animated_hook | full_video
  visualMode      String   @default("images")
  videoModel      String   @default("kwaivgi/kling-v3.0-std/image-to-video")
  /// Duration id e.g. "30", "long-15"
  duration        String   @default("30")
  publishTime     String   @default("12:00")
  /// How many videos to generate + auto-post each day (1–5)
  postsPerDay     Int      @default(1)
  /// Hours between posts on the same day (e.g. 2am + 4h → 2am, 6am, 10am)
  postIntervalHours Int     @default(4)
  /// Optional first publish datetime from calendar picker (ISO stored as DateTime)
  nextPublishAt   DateTime?
  timezone        String   @default("Europe/London")
  projectId       String?
  platforms       String[] @default([])
  /// Google Calendar event id when synced
  calendarEventId String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos SeriesVideo[]
}

model SeriesVideo {
  id             String    @id @default(cuid())
  seriesId       String
  /// 1-based episode number within the series
  episodeNumber  Int       @default(1)
  title          String?
  /// Long-form YouTube/Facebook description
  description    String?
  script         String?
  caption        String?
  status         String    @default("pending")
  mediaUrl       String?
  thumbnailUrl   String?
  audioUrl       String?
  musicUrl       String?
  scheduledAt    DateTime?
  generateAt     DateTime?
  publishedAt    DateTime?
  error          String?
  ayrsharePostId String?
  calendarEventId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([status, generateAt])
  @@index([status, scheduledAt])
  @@index([seriesId, episodeNumber])
}

/// Standalone long-form video generator (Forge /studio)
model StudioJob {
  id              String   @id @default(cuid())
  userId          String
  title           String?
  prompt          String
  script          String?
  /// Total target length in seconds (1–900)
  durationSec     Int      @default(30)
  aspectRatio     String   @default("16:9")
  /// WaveSpeed model path (kling / veo / seedance)
  videoModel      String   @default("kwaivgi/kling-v3.0-std/image-to-video")
  /// Character + style bible for consistency across clips
  styleBible      String?
  /// Optional user reference image URL
  referenceImageUrl String?
  status          String   @default("queued")
  /// 0–100
  progress        Int      @default(0)
  progressNote    String?
  /// JSON array of clip URLs
  clipUrls        String[] @default([])
  mediaUrl        String?
  thumbnailUrl    String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}
